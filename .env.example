NODE_ENV=development
APPLICATION_PORT=3000
LOG_LEVEL=info

# Mesmo segredo do OS Service e da Lambda de autenticação: este serviço só valida
# o token, não emite.
JWT_SECRET=troque-pelo-mesmo-segredo-do-os-service

# Token do sistema externo de aprovação de orçamento (header x-webhook-token)
WEBHOOK_ORCAMENTO_TOKEN=troque-por-um-token

# Banco e mensageria. Localmente apontam para o docker compose (o serviço
# `billing` do compose sobrescreve os endereços com os nomes internos); no
# cluster vêm do Secret e do ConfigMap (k8s/app/).
DATABASE_URL=postgresql://billing:billing@localhost:5433/billing?schema=public
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
BILLING_COMMANDS_QUEUE_URL=http://localhost:4566/000000000000/oficina-billing-commands
SAGA_REPLIES_QUEUE_URL=http://localhost:4566/000000000000/oficina-os-saga-replies

# Mercado Pago. Localmente, o simulador do docker compose (qualquer token serve).
# Com a API real: o Access Token de teste da aplicação do Checkout Pro e a URL
# pública do webhook (API Gateway + /billing/webhooks/mercado-pago).
MERCADO_PAGO_API_URL=http://localhost:8089
MERCADO_PAGO_ACCESS_TOKEN=TEST-simulador
MERCADO_PAGO_SANDBOX=true
# MERCADO_PAGO_NOTIFICATION_URL=https://<api-gateway>/billing/webhooks/mercado-pago

# E-mail pela Lambda de notificações (opcional; sem ele, nenhum e-mail é enviado)
# MAIL_LAMBDA_URL=https://<api-gateway>/mail
# MAIL_LAMBDA_TOKEN=

# Observabilidade (desligada no ambiente local)
NEW_RELIC_ENABLED=false
NEW_RELIC_APP_NAME=oficina-billing
